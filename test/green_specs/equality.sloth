### Name
equality

### Program
let matrix = [
  [1, 2],
  ["string", "a different string"],
  [true, false],
]

for let i = 0; i < 1; i = i + 1 {
  let first = (matrix[i])[0]
  let second = (matrix[i])[1]

  assert(first == first)
  assert(!(first == second))
  assert(first != second)
  assert(!(first != first))
  assert(first != null)
}

assert(null == null)

