### Name
equality

### Program
let matrix = [
  [1, 2, "Number"],
  ["string", "a different string", "String"],
  [true, false, "Bool"],
  [[1], [1, 2], "List"],
  [{"key": "value"}, {"key": "value2"}, "HashMap"],
]

for let i = 0; i < 5; i = i + 1 {
  let first = matrix[i][0]
  let second = matrix[i][1]
  let name = matrix[i][2]

  assert(first == first, name)
  assert(!(first == second), name)
  assert(first != second, name)
  assert(!(first != first), name)

  assert(first != null, name)
}

assert(null == null)
assert(!(null != null))

