### Program
let matrix = [
  [1, 2, "Number"],
  ["string", "a different string", "String"],
  [true, false, "Bool"],
  [[1], [1, 2], "List"],
  [{"key": "value"}, {"key": "value2"}, "HashMap"],
  [String, Number, "Prototype"],
  [Process.new(["uname"]), Process.new(["uname", "-a"]), "Process"],
  # These are different because they have different PIDs
  ["uname"&, "uname"&, "ProcessHandle"],
]

for arr in matrix {
  let first = arr[0]
  let second = arr[1]
  let name = arr[2]

  assert(first == first, name)
  assert(not (first == second), name)
  assert(first != second, name)
  assert(not (first != first), name)

  assert(first != null, name)
}

assert(null == null)
assert(not (null != null))

