### Program
with ($cwd = $scriptDir) {
  "./configure"!

  let buildDir = Directory("${$cwd}/build")
  if not buildDir.exists() { buildDir.create() }

  with ($cwd = buildDir.path()) {
    "cmake .."!
  }
}

