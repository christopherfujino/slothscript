assert($env == {"UNIT_TEST": "true"})
with ($env = {"FOO": "BAR"}) {
  assert($env == {"FOO": "BAR"})
  with ($env = $env.merge({"BAR": "BAZ"})) {
    assert($env == {
      "FOO": "BAR",
      "BAR": "BAZ",
    })
  }
}

