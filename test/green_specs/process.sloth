### Name
green_specs/process.sloth

### Program
#This short version...
let result1 = "uname" | "tr x s"!

# Is equivalent to the more verbose...
let result2 = Process.new(["uname"]) | Process.new(["tr", "x", "s"])!

# Because the pipe operator has rules for implicit casts

let handle = "uname"&
let result = handle.wait()
assert(result.stdout() == "Linux")

result = "uname"&!
assert(result.stdout() == "Linux")

