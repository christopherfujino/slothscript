### Program
#This short version...
let result1 = "uname" | "tr x s"!

# Is equivalent to the more verbose...
let result2 = Process.new(["uname"]) | Process.new(["tr", "x", "s"])!

# Because the pipe operator has rules for implicit casts

let handle = "uname"&
let result = handle.wait()
assert(result.stdout == "Linux\n", "${result}")

result = "uname"&!
assert(result.stdout == "Linux\n")

let proc = Process.new(["uname"])
proc.stdout = $stdout
handle = proc.forkInherit()
handle.wait()

