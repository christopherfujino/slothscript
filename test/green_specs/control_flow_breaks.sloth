### Name
return, break, continue, error

### Program
func earlyReturn() {
  return true
  assert(false)
}

assert(earlyReturn())

let i = for let i = 0; i < 10; i = i + 1 {
  if i == 4 {
    break i
  }
}

assert(i == 4);

let x = 0
let y = for let i = 0; i < 10; i = i + 1 {
  continue x + 1
}

assert(x == 0, "x = ${x}")

