### Name
return, break, continue, error

### Program
func earlyReturn() {
  return true
  assert(false)
}

assert(earlyReturn())

let k = for let i = 0; i < 10; i = i + 1 {
  if i == 4 {
    break i
  }
}

assert(k == 4);

let x = 0
let y = for let i = 0; i < 10; i = i + 1 {
  x = x + 1
  continue x
}

assert(y == 10, "y = ${y}")

