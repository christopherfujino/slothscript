### Program
let l = ["hi", ""]
let res = for file in l {
  continue 42
}

assert(res == 42)

# This was never broken, let's ensure it never does
for let i = 0; i < l.length; i = i + 1 {
  if l[i] == "" {
    continue
  }
}

