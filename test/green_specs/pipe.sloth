### Program
let pipe1 = Pipe.new()
pipe1.write.writeAll("Hello")
let pipeOut = pipe1.read.readAll()
assert(pipeOut == "Hello", pipeOut)

let pipe2 = Pipe.new()
with ($stderr = pipe2.write, $stdout = pipe2.write) {
  "git push --porcelain --set-upstream origin HEAD"!
}
pipeOut = pipe2.read.readAll()
assert(pipeOut == "out1\nerr\nout2\n", pipeOut)

### Processes
