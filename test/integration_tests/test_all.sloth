#!/usr/bin/env sloth

let sloth = if $env["SLOTH"] == null {
  'sloth'
} else {
  $env["SLOTH"]
}

with ($cwd = $scriptDir) {
  let tests = ("find -name 'test.sloth'"&!).
    stdout.
    trim().
    split("\n")

  for test in tests {
    print("Executing \"${test}\"...")
    [sloth, test]!
  }

  print("All ${tests.length} tests passed!")
}
