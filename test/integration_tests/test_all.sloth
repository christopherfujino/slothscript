#!/usr/bin/env sloth

let sloth = $env['SLOTH']
if sloth == null {
  print("Setting fallback sloth binary")
  sloth = 'sloth'
} else {
  print("Using SLOTH binary from env = ${sloth}")
}

with ($cwd = $scriptDir) {
  let tests = ("find -name 'test.sloth'"&!).
    stdout.
    trim().
    split("\n")

  for test in tests {
    print("Executing \"${test}\"...")
    [sloth, test]!
  }

  print("All ${tests.length} tests passed!")
}
