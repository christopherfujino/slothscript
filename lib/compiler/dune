(rule
 (action
  (with-stdout-to
   parser-merged.messages
   (run
    menhir
    --unused-token
    COMMENT
    %{dep:parser.mly}
    --merge-errors
    %{dep:parser.messages.auto}
    --merge-errors
    %{dep:parser.messages})))
 (mode
  (promote (until-clean))))

(rule
 ;(deps messages.check)
 (action
  (with-stdout-to
   parser_errors.ml
   (run
    menhir
    --unused-token
    COMMENT
    %{dep:parser.mly}
    --compile-errors
    %{dep:parser-merged.messages}))))
